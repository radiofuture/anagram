# Copy to anagram.env and fill in. Read by compose.yaml. Keep anagram.env private
# (it holds any ORCID client secret and SMTP password). See docs/deploy.md.

# --- Required ---
# Host name of the node. DNS A/AAAA records must point to this server.
ANAGRAM_DOMAIN=anagram.example.org
ANAGRAM_COMMUNITY=Example Structural Biology Community

# --- Optional: public URL override (read at each start) ---
# Default is https://<ANAGRAM_DOMAIN>. Set this if the node runs on a non-standard port.
# ANAGRAM_PUBLIC_URL=https://anagram.example.org

# --- Optional: ORCID client (read at each start) ---
# Only needed if you want members to link ORCID iDs or sign into /admin via ORCID.
# Register at https://orcid.org/developer-tools with exact redirect URI:
#   https://<ANAGRAM_DOMAIN>/auth/orcid/callback
# ANAGRAM_ORCID_CLIENT_ID=
# ANAGRAM_ORCID_CLIENT_SECRET=
# ANAGRAM_ORCID_SANDBOX=1

# Optional: these ORCID iDs become organizers when they join (first start only).
# ANAGRAM_ORGANIZER_ORCIDS=0000-0002-1825-0097

# Optional: the https page where a person gets the Anagram app (read at each start).
# The join page shows "Get Anagram" with this link.
# ANAGRAM_DOWNLOAD_URL=https://example.org/anagram

# --- Optional: email sign-in via SMTP (read at each start) ---
# Without SMTP, sign-in codes go to the node log only.
# ANAGRAM_SMTP_HOST=
# ANAGRAM_SMTP_PORT=587
# ANAGRAM_SMTP_FROM=
# ANAGRAM_SMTP_USER=
# ANAGRAM_SMTP_PASSWORD=

# --- Optional: lab policies (read at each start) ---
# Ciphertext quota per lab in MB (default: 2048).
# ANAGRAM_LAB_QUOTA_MB=2048
# Who can create labs: organizer_invite (default) or member.
# ANAGRAM_LAB_CREATE=organizer_invite

# --- Optional: matching enclave relay (read at each start) ---
# Matching runs only in the matching enclave of the network; this node
# relays sealed messages to it. See docs/enclave.md.
# ANAGRAM_ENCLAVE_URLS=
# ANAGRAM_ENCLAVE_LOG_URL=
# ANAGRAM_ENCLAVE_PINS=
# ANAGRAM_ENCLAVE_AFFILIATION=
# ANAGRAM_ENCLAVE_ADMIN=
# ANAGRAM_ENCLAVE_ROR=
# ANAGRAM_ENCLAVE_KIND=lab
# ANAGRAM_ENCLAVE_TICK_SECONDS=60

# --- Optional: time anchors (first start only) ---
# Defaults: FreeTSA, DigiCert, OpenTimestamps.
# ANAGRAM_TSA_URLS=https://freetsa.org/tsr,http://timestamp.digicert.com
# ANAGRAM_OTS=on
# ANAGRAM_OTS_CALENDARS=
# Full anchor list (overrides ANAGRAM_TSA_URLS, ANAGRAM_OTS, ANAGRAM_OTS_CALENDARS):
# ANAGRAM_ANCHORS=
# ANAGRAM_ANCHOR_BATCH_SECONDS=600
